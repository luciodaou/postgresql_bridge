DB_HOST=<db_host>
DB_PORT=<db_port>
DB_READONLY_USER=<readonly_user>
DB_READONLY_PASSWORD=<readonly_password>

# TLS to the database server (libpq-style sslmode):
# disable | require (encrypt, don't verify cert) | verify-ca | verify-full
DB_SSLMODE=require
# CA / server certificate file inside the container, used by verify-ca / verify-full
DB_SSLROOTCERT=

# Access control allowlists (comma-separated lists)
# UNIFORM RULE for all three (databases, schemas, tables):
# - If empty, not declared, or '*', all are allowed (unrestricted access).
# - If specified, access is strictly limited to the listed items.
ALLOWED_DATABASES=my_database
ALLOWED_SCHEMAS=public
ALLOWED_TABLES=

# Convenience aliases (can be used interchangeably with ALLOWED_*)
database=my_database
schema=public
tables=

# --- psql-cron exporter ---
# Dedicated credentials (separate from DB_READONLY_*)
CRON_DB_USER=<cron_readonly_user>
CRON_DB_PASSWORD=<cron_password>
# Allowlists for syncs (same rule as ALLOWED_*: empty or '*' = unrestricted)
CRON_ALLOWED_DATABASES=my_database
CRON_ALLOWED_SCHEMAS=my_schema
CRON_ALLOWED_TABLES=
# Writable export folders: host paths mounted into the container at the same path.
# Every output_path in cron/syncs/*.ini must be inside one of them; nothing else on the host is writable.
# CRON_EXPORT_DIR_2 is optional; leave empty if a single folder is enough.
CRON_EXPORT_DIR="/mnt/c/path/to/export folder"
CRON_EXPORT_DIR_2=
DEFAULT_CRON_SCHEDULE=0 * * * *
DEFAULT_OUTPUT_DIR=/app/output
RUN_ON_STARTUP=true
RUN_ONCE=false
LOG_LEVEL=INFO
